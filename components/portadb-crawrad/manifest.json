    {
      "class": "Dataset",
      "display": "Dataset",
      "palette": "Data",
      "prefix": "dst",
      "default_size": [28.0, 28.0],
      "visual": false,
      "private_state": false,
      "targets": ["*"],
      "provides": ["DbDataset", "DbRowSource"],
      "doc": "**The dataset that ordinary UI components bind to.**\n\nIt is the layer between a database connection and ordinary components\n(ADR 0041: there are no special DB controls — standard controls like an Edit\nor a Grid bind directly to a dataset).\n\n`table` and `sql` are mutually exclusive data sources, matching\n`portadb::DatasetSource`: specifying a `table` creates an editable,\nCRUD-capable dataset, whereas providing an `sql` query creates a read-only\ndataset.\n\nLike every component in this crate, this struct represents the designer\n**state**, not the runtime engine: it stores what the user configured in the\ndesigner without executing database operations.",
      "props": [
        {
          "key": "name",
          "display": "Name",
          "category": "identity",
          "kind": "text",
          "default": "",
          "doc": "The instance name. Every component has one, so the derive writes it."
        },
        {
          "key": "rect",
          "display": "Rect",
          "category": "layout",
          "kind": "rect",
          "default": { "x": 0.0, "y": 0.0, "w": 28.0, "h": 28.0 },
          "doc": "Where the instance sits. The size comes from `size` on the struct."
        },
        {
          "key": "connection",
          "display": "Connection",
          "category": "behavior",
          "kind": "reference",
          "default": "",
          "ref_class": "DbConnection",
          "doc": "**The connection component that this dataset points to.**\n\nEmpty is a dataset that has not yet chosen its connection. It binds to\nany component offering the `DbConnection` capability."
        },
        {
          "key": "table",
          "display": "Table",
          "category": "behavior",
          "kind": "text",
          "default": "",
          "doc": "The database table this dataset edits with full CRUD capabilities.\n\nWhen set, the dataset operates in editable mode over the specified table.\nThis is an alternative to [`sql`](Self::sql)."
        },
        {
          "key": "sql",
          "display": "SQL",
          "category": "behavior",
          "kind": "multiline",
          "default": "",
          "multiline": true,
          "doc": "A custom SQL query that provides a read-only dataset.\n\nWhen set instead of [`table`](Self::table), the dataset executes this query\nin read-only mode."
        },
        {
          "key": "active",
          "display": "Active",
          "category": "behavior",
          "kind": "bool",
          "default": false,
          "doc": "**The designer asks for an active dataset, it does not open it.**\n\nFollowing the same reasoning as [`Connection::connected`], toggling this\nflag in the designer records the desired state without opening live\ndatabase cursors at design time."
        }
      ],
